# =====================================================================
# ROOT GITIGNORE — this lives at the git-initialized parent folder to
# prevent accidental commits of parent node_modules, sibling projects,
# or stray outputs. ONLY the Nebula-search-engine--main/ project folder
# (and any supporting readme/license right here) is allowed in commits.
# =====================================================================

# By default, WHITELIST-EMPTY policy: ignore everything except the
# project folder and a few root-level markdown/admin files.
*
!*/
!.gitignore
!README.md
!LICENSE
!CHANGELOG.md
!CODE_OF_CONDUCT.md
!CONTRIBUTING.md
!SECURITY.md

# Allow the actual project — this is the ONLY real tree we commit.
!Nebula-search-engine--main/**

# =====================================================================
# Block common leak paths outright, even inside the project if any of
# these somehow sneak into tracked subfolders.
# =====================================================================

# Dependencies — never commit.
node_modules/
__pycache__/
.venv/
venv/
env/
.env
.env.*
!.env.example
!.env.development
!.env.production

# Build outputs.
dist/
build/
out/
.next/
.nuxt/
.cache/

# Logs, dumps, coverage, ad-hoc test outputs. *.txt is allowed ONLY for
# files like README.txt that were deliberately committed. These suffix
# based patterns catch the test/run artifacts we can see in the tree.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage & reports (any path: backend, frontend, root).
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
lcov-report/
lcov.info
coverage_*.txt
coverage-run*.txt
*_coverage.txt
*_coverage_*.txt
frontend/coverage/
full_test_results.txt
full_test_output.txt
mypy_check.txt
mypy_report.txt
run*.txt
out.txt
output.txt
results.txt
single_test.txt
test_run_output.txt
test_summary.txt
config_test.txt
all_e2e_test_output.txt
router_test*.txt
e2e_*_output.txt
e2e_results.txt
search_output.txt
test_output*.txt
documents_output.txt
test_ranking*.txt
test_ranking_output*.txt
Nebula-search-engine--main/frontend/*_test_output.txt
Nebula-search-engine--main/frontend/frontend_coverage.txt
Nebula-search-engine--main/frontend/build.err
Nebula-search-engine--main/frontend/npm-install.err

# Large binary / local storage.
*.db
*.sqlite
*.sqlite3
nebula.db
test_nebula.db
storage/cache/*
storage/uploads/*
storage/index/*
storage/exports/*
storage/vector/*

# IDEs / OS clutter.
.idea/
.vscode/
.vs/
.DS_Store
Thumbs.db
desktop.ini

# Runtime / lock clutter.
*.pid
*.seed
*.lock.tmp

# Keep gitkeep files, always.
!.gitkeep
