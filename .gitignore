# =====================================================================
# Nebula Search Engine — consolidated, repo-root .gitignore
# =====================================================================
# Merged from:
#   1. prior repo-root (whitelist/deny-by-default policy — OBSOLETE; now
#      flattened repo uses a conventional ignore list)
#   2. Nebula-search-engine--main/.gitignore (184 patterns)
# Plus new ignores for cache, generated Flutter ephemera, and local build
# artifacts that have leaked into the tree in prior commits.
# =====================================================================

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
wheels/

# ---------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------
.env
.env.local
.env.*.local
*.db
*.sqlite
*.sqlite3
test_nebula.db
nebula.db
debug_migration.db
# Keep the intentional template env files
!.env.example
!.env.development
!.env.production

# ---------------------------------------------------------------------
# OS / editor clutter
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
.vs/
*.swp
*.swo
*~
.project
.classpath
.settings

