yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
out/
*.tsbuildinfo
.next/
.nuxt/
.cache/

# ---------------------------------------------------------------------
# Docker / compose override
# ---------------------------------------------------------------------
docker-compose.override.yml
.dockerignore

# ---------------------------------------------------------------------
# Build output caches / storage scratch space
# ---------------------------------------------------------------------
.temp/
.tmp/
storage/cache/*
storage/uploads/*
storage/index/*
storage/exports/*
storage/vector/*
storage/indexes/*
storage/vectors/*
!storage/cache/.gitkeep
!storage/uploads/.gitkeep
!storage/index/.gitkeep
!storage/vector/.gitkeep
!storage/indexes/.gitkeep
!storage/vectors/.gitkeep

# ---------------------------------------------------------------------
# Process / lock / scratch
# ---------------------------------------------------------------------
*.pid
*.pid.lock
*.seed
*.lock.tmp

