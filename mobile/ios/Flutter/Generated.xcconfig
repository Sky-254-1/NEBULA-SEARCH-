// This is a TEMPLATE regenerated locally by running:
//   cd mobile && flutter create .
// The values below are placeholders; absolute local paths differ per machine.
// FLUTTER_ROOT=<absolute-path-to-flutter-sdk>
// FLUTTER_APPLICATION_PATH=<absolute-path-to-project>/mobile
// FLUTTER_FRAMEWORK_SWIFT_PACKAGE_PATH=<absolute-path-to-project>/mobile/ios/Flutter/ephemeral/Packages/.packages/FlutterFramework
COCOAPODS_PARALLEL_CODE_SIGN=true
FLUTTER_TARGET=lib/main.dart
FLUTTER_BUILD_DIR=build
FLUTTER_BUILD_NAME=1.0.0
FLUTTER_BUILD_NUMBER=1
EXCLUDED_ARCHS[sdk=iphonesimulator*]=i386
EXCLUDED_ARCHS[sdk=iphoneos*]=armv7
DART_OBFUSCATION=false
TRACK_WIDGET_CREATION=true
TREE_SHAKE_ICONS=false
PACKAGE_CONFIG=.dart_tool/package_config.json
