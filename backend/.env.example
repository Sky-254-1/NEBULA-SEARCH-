# =====================================================================
# NEBULA SEARCH - Environment Configuration (Sanitized Example)
# =====================================================================
# This file contains all required and optional configuration variables.
# Copy this file to .env and fill in the actual values.
# DO NOT commit real secrets to version control.
# =====================================================================

# =====================================================================
# APPLICATION SETTINGS
# =====================================================================

# Environment mode: development, staging, production
APP_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=debug

# =====================================================================
# DATABASE CONFIGURATION
# =====================================================================

# SQLite file path (development)
# DATABASE_URL=nebula.db

# PostgreSQL connection string (production)
# Required format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://nebula:change-me@localhost:5432/nebula

# =====================================================================
# REDIS CONFIGURATION (Optional)
# =====================================================================
# Required for distributed cache, rate limiting, and session storage

REDIS_URL=redis://localhost:6379/0

# =====================================================================
# CACHE SETTINGS
# =====================================================================

# Cache TTL in seconds
CACHE_TTL_SECONDS=300

# =====================================================================
# SECURITY SECRETS - REQUIRED IN PRODUCTION
# =====================================================================

# JWT Secret - Minimum 32 characters in production
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here-minimum-32-chars

# JWT Configuration
JWT_EXPIRY_HOURS=24
JWT_EXPIRY_MINUTES=30
REFRESH_TOKEN_DAYS=30
JWT_ISSUER=Nebula Search
JWT_AUDIENCE=nebula-search-api

# Session Secret - For secure session management
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-session-secret-here

# Encryption Key - For data at rest
# Must be exactly 32 bytes (base64 encoded)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded

# =====================================================================
# STORAGE CONFIGURATION
# =====================================================================

# Storage root directory
STORAGE_ROOT=../storage

# Storage backend: local, s3, minio
STORAGE_BACKEND=local

# MinIO Configuration (if using MinIO)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=your-minio-access-key
# MINIO_SECRET_KEY=your-minio-secret-key
# MINIO_USE_SSL=false

# =====================================================================
# AUTHENTICATION & SECURITY SETTINGS
# =====================================================================

# Authentication cookie mode (true = cookies, false = JWT headers)
AUTH_COOKIE_MODE=true

# Cookie security settings
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Enable Role-Based Access Control (RBAC)
ENABLE_RBAC=true

# Enable refresh token reuse detection
ENABLE_REFRESH_REUSE_DETECTION=true

# Enable audit logging
ENABLE_AUDIT_LOGS=true

# =====================================================================
# BRUTE-FORCE PROTECTION
# =====================================================================

# Maximum login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
LOGIN_LOCKOUT_MINUTES=15

# Rate limits
SIGNUP_RATE_LIMIT=5
LOGIN_RATE_LIMIT=5
REFRESH_RATE_LIMIT=10

# =====================================================================
# CONTENT SECURITY POLICY (CSP)
# =====================================================================

CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self'
CSP_STYLE_SRC='self'
CSP_IMG_SRC='self' data:
CSP_CONNECT_SRC='self'
CSP_FONT_SRC='self'
CSP_FRAME_SRC='none'
CSP_OBJECT_SRC='none'
CSP_REPORT_URI=

# =====================================================================
# FEATURE FLAGS
# =====================================================================

# Enable CSRF protection
ENABLE_CSRF=true

# Enable Two-Factor Authentication (2FA)
ENABLE_2FA=false

# Enable WebAuthn (FIDO2) authentication
ENABLE_WEBAUTHN=false

# Require email verification on signup
REQUIRE_EMAIL_VERIFICATION=false

# Enable SAML 2.0 SSO
ENABLE_SAML=false

# =====================================================================
# 2FA / TOTP CONFIGURATION
# =====================================================================

# TOTP issuer name (shown in authenticator apps)
TOTP_ISSUER=Nebula Search

# =====================================================================
# CORS CONFIGURATION
# =====================================================================

# Comma-separated list of allowed origins (required when using credentials)
# A literal * is not allowed when allow_credentials=True
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# =====================================================================
# ADMIN SETTINGS
# =====================================================================

# Comma-separated list of IP addresses allowed to access admin endpoints
ADMIN_IP_WHITELIST=

# =====================================================================
# AI PROVIDER CONFIGURATION
# =====================================================================

# AI provider: auto, openai, ollama, gguf, duckduckgo
AI_PROVIDER=auto

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# GGUF Model Configuration
GGUF_MODEL_PATH=

# =====================================================================
# SEARCH API KEYS (Optional)
# =====================================================================

# Brave Search API Key
BRAVE_API_KEY=

# SerpAPI Key
SERPAPI_KEY=

# =====================================================================
# EMAIL/SMTP CONFIGURATION (Optional)
# =====================================================================

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nebula Search
SMTP_USE_TLS=true

# Email verification and password reset expiry (hours)
EMAIL_VERIFICATION_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_HOURS=1

# =====================================================================
# API KEY SETTINGS
# =====================================================================

# API key length and prefix
API_KEY_LENGTH=32
API_KEY_PREFIX=nb_

# =====================================================================
# RATE LIMIT TIERS (requests per minute)
# =====================================================================

RATE_LIMIT_TIER_BASIC=30
RATE_LIMIT_TIER_PRO=120
RATE_LIMIT_TIER_ENTERPRISE=600
RATE_LIMIT_BURST_MULTIPLIER=2

# =====================================================================
# DOCUMENT PREVIEW SETTINGS
# =====================================================================

# Enable document preview generation
ENABLE_DOCUMENT_PREVIEW=true

# Maximum file size for preview in MB
MAX_PREVIEW_SIZE_MB=50

# =====================================================================
# FEDERATED SEARCH SETTINGS
# =====================================================================

ENABLE_FEDERATED_SEARCH=false
FEDERATED_SEARCH_DEVICES=

# =====================================================================
# PLUGIN SYSTEM SETTINGS
# =====================================================================

ENABLE_PLUGIN_SYSTEM=false
PLUGIN_DIRECTORY=../plugins

# =====================================================================
# OBSERVABILITY - SENTRY
# =====================================================================

SENTRY_DSN=

# =====================================================================
# OBSERVABILITY - OPENTELEMETRY
# =====================================================================

OTEL_SERVICE_NAME=nebula-search
OTEL_EXPORTER_OTLP_ENDPOINT=

# =====================================================================
# LOGGING FORMAT
# =====================================================================

LOG_JSON_FORMAT=false

# =====================================================================
# CROSS-ORIGIN HEADERS
# =====================================================================

CROSS_ORIGIN_EMBEDDER_POLICY=require-corp
CROSS_ORIGIN_OPENER_POLICY=same-origin
CROSS_ORIGIN_RESOURCE_POLICY=same-origin

# =====================================================================
# CRAWLER SETTINGS
# =====================================================================

CRAWLER_USER_AGENT=NebulaSearch/1.0
CRAWLER_MAX_CONCURRENCY=10
CRAWLER_DEFAULT_DELAY=1.0
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES_PER_JOB=100
CRAWLER_ROBOTS_TTL=86400

# =====================================================================
# PERMISSIONS POLICY
# =====================================================================

PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()

# =====================================================================
# INDEXING SYSTEM SETTINGS
# =====================================================================

# Max number of items in indexing queue
INDEXING_MAX_QUEUE_SIZE=10000

# Number of worker processes for indexing
INDEXING_WORKER_COUNT=2

# Maximum retries for failed indexing operations
INDEXING_MAX_RETRIES=5

# Base delay between retries (seconds)
INDEXING_RETRY_BASE_DELAY=5.0

# Multiplier for exponential backoff
INDEXING_RETRY_BACKOFF_MULTIPLIER=3.0

# Document chunking for embedding
INDEXING_CHUNK_SIZE=1000
INDEXING_CHUNK_OVERLAP=200

# =====================================================================
# PUSH NOTIFICATIONS (Optional)
# =====================================================================

ENABLE_PUSH_NOTIFICATIONS=false
FCM_SERVER_KEY=
FCM_PROJECT_ID=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.nebula.search

# =====================================================================
# OAUTH2 / SSO CONFIGURATION (Optional)
# =====================================================================

# Google OAuth2
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_BASE_URI=http://localhost:8000/api/v1/auth/oauth2
OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:5173/oauth/callback

# GitHub OAuth2
GITHUB_OAUTH2_CLIENT_ID=
GITHUB_OAUTH2_CLIENT_SECRET=

# =====================================================================
# WEBAUTHN (FIDO2) CONFIGURATION
# =====================================================================

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Nebula Search

# =====================================================================
# SAML 2.0 CONFIGURATION
# =====================================================================

SAML_ENTITY_ID=nebula-search
SAML_METADATA_URL=
SAML_CERT_PATH=
SAML_KEY_PATH=

# =====================================================================
# ELASTICSEARCH CONFIGURATION (Optional)
# =====================================================================

ELASTICSEARCH_URL=http://localhost:9200

# =====================================================================
# RABBITMQ CONFIGURATION (Optional)
# =====================================================================

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# =====================================================================
# KAFKA CONFIGURATION (Optional)
# =====================================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# =====================================================================
# POSTGRES (Production Reference)
# =====================================================================
# Required when using PostgreSQL instead of SQLite
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_PORT=5432

# =====================================================================
# MINIO (Production Reference)
# =====================================================================
# Required when using MinIO instead of local storage
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_BROWSER_REDIRECT_URL=

# =====================================================================
# GRAFANA (Production Reference)
# =====================================================================
# Required for monitoring dashboard access
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=

# =====================================================================
# REQUIRED VARIABLE SUMMARY
# =====================================================================
# 
# DEVELOPMENT:
# - APP_ENV (default: development)
# - DATABASE_URL (default: nebula.db)
# - JWT_SECRET (auto-generated in development)
# - SESSION_SECRET (auto-generated in development)
# - ENCRYPTION_KEY (auto-generated in development)
# 
# PRODUCTION (must be explicitly set):
# - APP_ENV=production
# - DATABASE_URL (PostgreSQL connection string)
# - JWT_SECRET (minimum 32 characters)
# - SESSION_SECRET
# - ENCRYPTION_KEY (exactly 32 bytes, base64-encoded)
# 
# =====================================================================
