# ==============================================================================
# NEBULA SEARCH BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# Copy this template to backend/.env:
#   cp backend/.env.example backend/.env
# In production, ensure all secrets are provisioned with strong random values.
# ==============================================================================

# Database (SQLite file path or PostgreSQL URL)
DATABASE_URL=nebula.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://nebula:replace-with-a-secure-database-password@localhost:5432/nebula

# Authentication & Cryptographic Secrets (Min 32 characters required in production)
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
SESSION_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
ENCRYPTION_KEY=replace-with-a-secure-random-secret-at-least-32-chars-long
JWT_EXPIRY_HOURS=24
JWT_EXPIRY_MINUTES=30
REFRESH_TOKEN_DAYS=30

# AI Providers (auto | openai | ollama | gguf | duckduckgo)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GGUF_MODEL_PATH=

# Search API Keys (Optional)
BRAVE_API_KEY=
SERPAPI_KEY=

# Redis (Optional — enables distributed cache)
REDIS_URL=
CACHE_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Environment & CORS
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Storage Root
STORAGE_ROOT=../storage
