{
  "name": "nebula-search-desktop",
  "version": "1.0.0",
  "description": "Nebula Search Desktop App",
  "main": "main.js",
  "author": "Nebula Search",
  "license": "MIT",
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "build": "cd ../frontend && npm run build && cd ../desktop && electron-builder",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nebula.search",
    "productName": "Nebula Search",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "../frontend/dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}