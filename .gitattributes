# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text
*.js text
*.ts text
*.tsx text
*.json text
*.yml text
*.yaml text
*.md text
*.html text
*.css text
*.scss text
*.sass text
*.txt text
*.xml text
*.sql text
*.sh text
*.bash text
*.c text
*.h text
*.cpp text
*.hpp text
*.java text
*.go text
*.rs text
*.rb text
*.php text

# Declare files that will always have CRLF line endings on checkout (Windows)
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Denote files that should always use LF on all platforms
*.sh text eol=lf
*.bash text eol=lf
