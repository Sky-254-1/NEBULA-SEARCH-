# ==============================================================================
# NEBULA SEARCH — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to create your local environment file:
#      cp .env.example .env               # For standard local setup
#      cp .env.example .env.development   # For explicit development profile
#      cp .env.example .env.production    # For server/production deployment
# 2. NEVER commit real environment files (.env, .env.*) to version control.
# 3. For production deployments:
#    - Replace every placeholder below with cryptographically random secrets.
#    - Generate keys using: python -c "import secrets; print(secrets.token_urlsafe(48))"
#    - Or using OpenSSL:   openssl rand -base64 36
#    - Keep external API keys empty if not utilized.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Security
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# Cryptographic secrets — MUST be changed before production deployment (min 32 chars)
SECRET_KEY=replace-with-a-secure-random-secret-at-least-32-chars-long
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
SESSION_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
ENCRYPTION_KEY=replace-with-a-secure-random-secret-at-least-32-chars-long

# Domain and Hostname configuration
DOMAIN_NAME=localhost

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=nebula
POSTGRES_PASSWORD=replace-with-a-secure-database-password
POSTGRES_DB=nebula
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nebula:replace-with-a-secure-database-password@postgres:5432/nebula

# ------------------------------------------------------------------------------
# 3. Caching & Messaging (Redis & RabbitMQ & Kafka)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

RABBITMQ_USER=nebula
RABBITMQ_PASSWORD=replace-with-a-secure-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

KAFKA_PORT=9092

# ------------------------------------------------------------------------------
# 4. Search & Vector Engine (Elasticsearch & Ollama)
# ------------------------------------------------------------------------------
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_HTTP_PORT=9200
OLLAMA_URL=http://localhost:11434
STORAGE_BACKEND=local
STORAGE_ROOT=./storage

# ------------------------------------------------------------------------------
# 5. Object Storage (MinIO S3 Compatible)
# ------------------------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=nebula_minio_admin
MINIO_ROOT_PASSWORD=replace-with-a-secure-minio-password
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# ------------------------------------------------------------------------------
# 6. Monitoring & Observability (Prometheus & Grafana)
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://localhost:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-secure-grafana-password
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------------------------------------------
# 7. Ports & Networking
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
WORKERS_PER_CORE=1
MAX_WORKERS=4

# ------------------------------------------------------------------------------
# 8. Email / SMTP (Optional)
# ------------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# 9. External APIs (Optional — keep empty if unused)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
BRAVE_API_KEY=
SERPAPI_KEY=
GOOGLE_API_KEY=
BING_API_KEY=

# ------------------------------------------------------------------------------
# 10. Feature Flags & Policies
# ------------------------------------------------------------------------------
ENABLE_VECTOR_SEARCH=true
ENABLE_AI_ANSWERS=true
ENABLE_WEBHOOKS=true
ENABLE_PUSH_NOTIFICATIONS=false
MFA_ENABLED=true
SESSION_TIMEOUT=3600
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ------------------------------------------------------------------------------
# 11. Deployment, SSL & Cloud Providers (Optional)
# ------------------------------------------------------------------------------
SSL_EMAIL=admin@example.com
SSL_DOMAINS=nebula.example.com

AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
ECR_REPOSITORY=nebula-backend
KUBE_CONFIG=

GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
