# Nebula Search - Environment Configuration
# Copy this file to .env and replace every placeholder with a unique secret.
# Never use this template's placeholders in deployment.

# Application
APP_ENV=development
LOG_LEVEL=info
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
JWT_SECRET=replace_with_a_different_random_secret_at_least_32_characters_long

# Database
POSTGRES_USER=nebula
POSTGRES_PASSWORD=replace_with_a_unique_random_database_password
POSTGRES_DB=nebula
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nebula:replace_with_url_safe_database_password@localhost:5432/nebula

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Storage
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
MINIO_ROOT_USER=nebula-local
MINIO_ROOT_PASSWORD=replace_with_a_unique_random_minio_password
RABBITMQ_USER=nebula
RABBITMQ_PASSWORD=replace_with_a_unique_random_rabbitmq_password

# External APIs (optional)
# Keep the real key in this ignored .env file or a secret manager, never in source control.
OPENAI_API_KEY=
BRAVE_API_KEY=
SERPAPI_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=
BING_API_KEY=
GEMINI_API_KEY=

# Local AI provider configuration (no API keys required)
AI_PROVIDER=auto
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GGUF_MODEL_PATH=

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENABLED=false

# Monitoring (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature Flags
ENABLE_VECTOR_SEARCH=true
ENABLE_AI_ANSWERS=true
ENABLE_WEBHOOKS=true
ENABLE_PUSH_NOTIFICATIONS=false

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Security
ENCRYPTION_KEY=your-encryption-key-here
MFA_ENABLED=true
SESSION_TIMEOUT=3600

# Deployment
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# SSL (for production)
SSL_EMAIL=admin@example.com
SSL_DOMAINS=nebula.example.com

# AWS (for production deployment)
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
ECR_REPOSITORY=nebula-backend

# Kubernetes
KUBE_CONFIG=

# CI/CD
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
